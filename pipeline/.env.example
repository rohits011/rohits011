# Copy to pipeline/.env and fill in what you use. Dry runs need none of these.

# Script generation (required for live runs)
ANTHROPIC_API_KEY=

# TTS — set the one matching tts.provider in config.yaml
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Stock footage (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=
