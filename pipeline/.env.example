# Copy to pipeline/.env and fill in what you use.
# The zero-cost stack (--script-file + edge TTS) needs ONLY the Pexels key,
# which is free — no card, no subscription: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional paid providers:
ANTHROPIC_API_KEY=       # LLM script generation (instead of --script-file)
OPENAI_API_KEY=          # tts.provider: openai
ELEVENLABS_API_KEY=      # tts.provider: elevenlabs
